{
  "about": "settingsSchema.parse(raw) for files older than schema v7 — the Electron app's own migrations",
  "note": "The native app does not run these migrations (design decision 9): a file older than v7 falls back to defaults and onboarding. These cases pin the Electron behaviour only.",
  "cases": [
    {
      "name": "legacy provider ids map onto current ones, and demo turns off once",
      "input": {
        "placementPreset": "left-edge",
        "enabledProviderIds": ["claude", "chatgpt", "spark"],
        "demoMode": true,
        "pollIntervalMs": 60000,
        "launchAtLogin": false,
        "customPosition": null
      },
      "expected": {
        "accepted": {
          "placementPreset": "left-edge",
          "enabledProviderIds": ["claude", "codex", "grok"],
          "demoMode": false,
          "pollIntervalMs": 60000,
          "launchAtLogin": false,
          "hudScale": 1,
          "hudTheme": "auto",
          "dockStyle": "rail",
          "cornerArc": false,
          "notificationPopups": true,
          "autoUpdateCheck": true,
          "autoUpdateDownload": false,
          "autoHide": true,
          "hideDelay": "normal",
          "customCorner": null,
          "topEdgeNotch": true,
          "usageDisplay": "used",
          "customPosition": null,
          "schemaVersion": 7
        }
      }
    },
