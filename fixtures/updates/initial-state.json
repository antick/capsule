        "releaseNotes": null,
        "checkedAt": null,
        "progress": null,
        "error": null,
        "canInstall": true
      }
    },
    {
      "name": "build that cannot replace itself",
      "input": {
        "version": "0.1.0",
        "canInstall": false
      },
      "expected": {
        "phase": "unsupported",
        "currentVersion": "0.1.0",
        "availableVersion": null,
        "releaseNotes": null,
        "checkedAt": null,
        "progress": null,
        "error": null,
        "canInstall": false
      }
    }
  ]
}
