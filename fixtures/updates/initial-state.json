{
  "about": "initialUpdateState(version, canInstall) — the state before anything has been asked",
  "cases": [
    {
      "name": "installable build",
      "input": {
        "version": "0.1.0",
        "canInstall": true
      },
      "expected": {
        "phase": "idle",
        "currentVersion": "0.1.0",
