{
  "about": "plainReleaseNotes(raw) — release notes reduced to plain text for the updates pane",
  "cases": [
    {
      "name": "markup is dropped and the words kept",
      "input": "<p>Fixed the <b>dock</b></p>",
      "expected": "Fixed the dock"
    },
    {
      "name": "list items become bullets",
      "input": "<ul><li>One</li><li>Two</li></ul>",
      "expected": "• One\n• Two"
    },
    {
      "name": "several skipped releases are joined",
      "input": [
        {
          "version": "0.2.0",
          "note": "Second"
        },
        {
          "version": "0.1.1",
          "note": "First"
        }
      ],
      "expected": "Second\n\nFirst"
    },
    {
      "name": "entities are unescaped",
      "input": "Rings &amp; bars &lt;3",
      "expected": "Rings & bars <3"
    },
    {
      "name": "absent notes",
      "input": null,
      "expected": null
    },
    {
      "name": "blank notes",
      "input": "   ",
      "expected": null
    },
    {
      "name": "markup with no words",
      "input": "<p></p>",
      "expected": null
    },
    {
      "name": "a long body is capped",
      "input": "",
      "expected": "…"
    },
    {
      "name": "headings and paragraphs keep their breaks",
      "input": "<h2>0.2.0</h2><p>One thing.</p><p>Another.</p>",
      "expected": "0.2.0\nOne thing.\nAnother."
    },
    {
      "name": "a release with no note",
      "input": [
        {
          "version": "0.2.0",
          "note": null
        },
        {
          "version": "0.1.1",
          "note": "First"
        }
      ],
      "expected": "First"
    }
  ]
}
