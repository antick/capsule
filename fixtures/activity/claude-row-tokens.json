{
  "about": "claudeRowTokens(row) — tokens billed for one Claude Code transcript row",
  "cases": [
    {
      "name": "every kind of token counts",
      "input": {
        "timestamp": "2026-09-06T12:00:00.000Z",
        "message": {
          "usage": {
            "input_tokens": 10,
            "cache_read_input_tokens": 100,
            "cache_creation_input_tokens": 5,
            "output_tokens": 20
          }
        }
      },
      "expected": {
        "at": "2026-09-06T12:00:00.000Z",
        "tokens": 135
      }
    },
    {
      "name": "a row without usage",
      "input": {
        "timestamp": "2026-09-06T12:00:00.000Z",
        "type": "user"
      },
      "expected": null
    },
    {
      "name": "not an object",
      "input": "nope",
      "expected": null
    },
    {
      "name": "zero tokens is no row",
      "input": {
        "timestamp": "2026-09-06T12:00:00.000Z",
        "message": {
          "usage": {
            "input_tokens": 0,
            "output_tokens": 0
          }
        }
      },
      "expected": null
    },
    {
      "name": "a non-numeric count is ignored",
      "input": {
        "timestamp": "2026-09-06T12:00:00.000Z",
        "message": {
          "usage": {
            "input_tokens": "12",
            "output_tokens": 3
          }
        }
      },
      "expected": {
        "at": "2026-09-06T12:00:00.000Z",
        "tokens": 3
      }
    },
    {
      "name": "a timestamp in epoch seconds",
      "input": {
        "timestamp": 1788696000,
        "message": {
          "usage": {
            "output_tokens": 7
          }
        }
      },
      "expected": {
        "at": "2026-09-06T12:00:00.000Z",
        "tokens": 7
      }
    },
    {
      "name": "a timestamp in epoch milliseconds",
      "input": {
        "timestamp": 1788696000000,
        "message": {
          "usage": {
            "output_tokens": 7
          }
        }
      },
      "expected": {
        "at": "2026-09-06T12:00:00.000Z",
        "tokens": 7
      }
    },
    {
      "name": "an unreadable timestamp",
      "input": {
        "timestamp": "soon",
        "message": {
          "usage": {
            "output_tokens": 7
          }
        }
      },
      "expected": null
    }
  ]
}
