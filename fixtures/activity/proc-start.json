{
  "about": "parseProcStart(text) — the ctime string Claude Code records for a process start, read as UTC",
  "cases": [
    {
      "name": "a space-padded single-digit day",
      "input": "Sat Sep  5 15:30:55 2026",
      "expected": "2026-09-05T15:30:55.000Z"
    },
    {
      "name": "a two-digit day",
      "input": "Fri Aug 28 05:15:20 2026",
      "expected": "2026-08-28T05:15:20.000Z"
    },
    {
      "name": "surrounding whitespace",
      "input": "  Thu Jan  1 00:00:00 2026\n",
      "expected": "2026-01-01T00:00:00.000Z"
    },
    {
      "name": "not a ctime string",
      "input": "yesterday",
      "expected": null
    },
    {
      "name": "too many fields",
      "input": "Sat Sep 5 15:30:55 2026 UTC",
      "expected": null
    },
    {
      "name": "empty",
      "input": "",
      "expected": null
    }
  ]
}
