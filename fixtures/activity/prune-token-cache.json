{
  "about": "pruneTokenCache(cache, keep) — forget files that are gone, newest kept first",
  "cases": [
    {
      "name": "files that are gone are forgotten",
      "input": {
        "cache": {
          "/a": {
            "size": 100,
            "modifiedMs": 3,
            "days": {
              "2026-09-06": 3
            }
          },
          "/b": {
            "size": 100,
            "modifiedMs": 2,
            "days": {
              "2026-09-06": 2
            }
          },
          "/c": {
            "size": 100,
            "modifiedMs": 1,
            "days": {
              "2026-09-06": 1
            }
          }
        },
        "keep": [
          "/a",
          "/c"
        ]
      },
      "expected": [
        [
          "/a",
          {
            "size": 100,
            "modifiedMs": 3,
            "days": {
              "2026-09-06": 3
            }
          }
        ],
        [
          "/c",
          {
            "size": 100,
            "modifiedMs": 1,
            "days": {
              "2026-09-06": 1
            }
          }
        ]
      ]
    },
    {
      "name": "kept newest first",
      "input": {
        "cache": {
          "/old": {
            "size": 100,
            "modifiedMs": 1,
            "days": {
              "2026-09-06": 1
            }
          },
          "/new": {
            "size": 100,
            "modifiedMs": 9,
            "days": {
              "2026-09-06": 9
            }
          },
          "/mid": {
            "size": 100,
            "modifiedMs": 5,
            "days": {
              "2026-09-06": 5
            }
          }
        },
        "keep": [
          "/old",
          "/new",
          "/mid"
        ]
      },
      "expected": [
        [
          "/new",
          {
            "size": 100,
            "modifiedMs": 9,
            "days": {
              "2026-09-06": 9
            }
          }
        ],
        [
          "/mid",
          {
            "size": 100,
            "modifiedMs": 5,
            "days": {
              "2026-09-06": 5
            }
          }
        ],
        [
          "/old",
          {
            "size": 100,
            "modifiedMs": 1,
            "days": {
              "2026-09-06": 1
            }
          }
        ]
      ]
    },
    {
      "name": "nothing kept",
      "input": {
        "cache": {
          "/a": {
            "size": 100,
            "modifiedMs": 1,
            "days": {
              "2026-09-06": 1
            }
          }
        },
        "keep": []
      },
      "expected": []
    }
  ]
}
