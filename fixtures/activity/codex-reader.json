{
  "about": "readCodexSessions(host) — Codex sessions from the thread index, a scan of recent rollouts, or the desktop catalogue",
  "timeZone": "UTC",
  "cases": [
    {
      "name": "a freshly written indexed rollout is an unconfirmed hint",
      "input": {
        "home": "/home",
        "now": "2026-09-06T13:00:00.000Z",
        "files": {},
        "dirs": {},
        "modified": {
          "/home/.codex/sessions/2026/09/06/a.jsonl": "2026-09-06T12:59:57.000Z"
        },
        "processes": {},
        "queries": {
          "/home/.codex/state_5.sqlite": [
            [
              "t1",
              "Fix uploads",
              "/home/.codex/sessions/2026/09/06/a.jsonl"
            ]
          ]
        },
        "readTail": true
      },
      "expected": {
        "sessions": [
          {
            "id": "codex.t1",
            "providerId": "codex",
            "name": "Fix uploads",
            "detail": "Recent activity · status unconfirmed",
            "state": "busy",
            "confirmed": false,
            "waitingFor": null,
            "since": "2026-09-06T12:59:57.000Z"
          }
        ],
        "queries": [
          {
            "db": "/home/.codex/state_5.sqlite",
            "sql": "SELECT id, title, rollout_path FROM threads WHERE archived = 0 AND source NOT LIKE '{\"subagent\"%' ORDER BY updated_at_ms DESC LIMIT 100"
          }
        ],
        "tails": [
          "/home/.codex/sessions/2026/09/06/a.jsonl"
        ]
      }
    },
