      "expected": {
        "sessions": [
          {
            "id": "grok.a2",
            "providerId": "grok",
            "name": "p",
            "detail": "Working · local task event",
            "state": "busy",
            "confirmed": true,
            "waitingFor": null,
            "since": "2026-09-06T12:59:59.000Z"
          },
          {
            "id": "grok.a1",
            "providerId": "grok",
            "name": "p",
            "detail": "Working · local task event",
            "state": "busy",
            "confirmed": true,
            "waitingFor": null,
            "since": "2026-09-06T12:59:51.000Z"
          }
        ],
        "queries": [],
        "tails": [
          "/home/.grok/sessions/p/a2/events.jsonl",
