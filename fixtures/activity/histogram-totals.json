{
  "about": "histogramTotals(days, now) — today's and the window's token totals from a per-day histogram",
  "timeZone": "UTC",
  "cases": [
    {
      "name": "today and the month",
      "input": {
        "now": "2026-09-06T20:00:00Z",
        "days": {
          "2026-09-06": 500,
          "2026-09-01": 300,
          "2026-08-20": 200
        }
      },
      "expected": {
        "today": 500,
        "month": 1000
      }
    },
    {
      "name": "a day before the window is left out",
      "input": {
        "now": "2026-09-06T20:00:00Z",
        "days": {
          "2026-09-06": 10,
          "2026-08-07": 999,
          "2026-08-08": 1
        }
      },
      "expected": {
        "today": 10,
        "month": 11
      },
      "note": "The window is the last 30 days counting today, so 2026-08-08 is in and 2026-08-07 is out."
    },
    {
      "name": "a day after today is left out",
      "input": {
        "now": "2026-09-06T20:00:00Z",
        "days": {
          "2026-09-07": 50,
          "2026-09-06": 5
        }
      },
      "expected": {
        "today": 5,
        "month": 5
      }
    },
    {
      "name": "nothing today",
      "input": {
        "now": "2026-09-06T20:00:00Z",
        "days": {
          "2026-09-05": 40
        }
      },
      "expected": {
        "today": 0,
        "month": 40
      }
    },
    {
      "name": "empty",
      "input": {
        "now": "2026-09-06T20:00:00Z",
        "days": {}
      },
      "expected": {
        "today": 0,
        "month": 0
      }
    }
  ]
}
