{
  "about" : "grokTokenFromFile / cursorTokenFromHex — pulling a token out of a tool's own auth file",
  "cases" : [
    {
      "expected" : "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.sig",
      "input" : {
        "raw" : "{\"https://accounts.x.ai/sign-in\":{\"key\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.sig\"}}",
        "reader" : "grok"
      },
      "name" : "grok: JWT nested under the sign-in URL"
    },
    {
      "expected" : "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.sig",
      "input" : {
        "raw" : "{\"https://accounts.x.ai/sign-in\":{\"key\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.sig\",\"expires_at\":\"2020-01-01T00:00:00Z\",\"user_id\":\"user-1\"}}",
        "reader" : "grok"
      },
      "name" : "grok: an expired entry is still read",
      "note" : "Expiry is the provider's call to make, not Capsule's. Refusing a stale-looking token locally only turns a working read into a blank meter."
    },
    {
      "expected" : null,
      "input" : {
        "raw" : "{}",
        "reader" : "grok"
      },
      "name" : "grok: no token"
    },
    {
      "expected" : "x.eyJzdWIiOiJ1c2VyXzQyIn0.y",
      "input" : {
        "raw" : "782e65794a7a645749694f694a3163325679587a5179496e302e79",
        "reader" : "cursor-hex"
      },
      "name" : "cursor: hex-encoded JWT from the state store",
      "note" : "Cursor's state store hands the token back hex-encoded."
    },
    {
      "expected" : "x.eyJzdWIiOiJ1c2VyXzQyIn0.y",
      "input" : {
        "raw" : "x.eyJzdWIiOiJ1c2VyXzQyIn0.y",
        "reader" : "cursor-hex"
      },
      "name" : "cursor: a token that is already plain passes through"
    },
    {
      "expected" : null,
      "input" : {
        "raw" : "  ",
        "reader" : "cursor-hex"
      },
      "name" : "cursor: blank input"
    },
    {
      "expected" : "user_42",
      "input" : {
        "raw" : "x.eyJzdWIiOiJ1c2VyXzQyIn0.y",
        "reader" : "cursor-subject"
      },
      "name" : "cursor: subject read off the JWT payload"
    },
    {
      "expected" : null,
      "input" : {
        "raw" : "nope",
        "reader" : "cursor-subject"
      },
      "name" : "cursor: subject of a non-JWT"
    }
  ]
}
