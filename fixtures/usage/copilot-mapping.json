{
  "about": "mapCopilotUsage(payload, now) — Copilot quota snapshots to a Capsule snapshot",
  "timeZone": "UTC",
  "frozenNow": "2026-08-27T11:22:00Z",
  "cases": [
    {
      "name": "percent remaining becomes percent used and unlimited quotas are skipped",
      "input": {
        "quota_reset_date": "2026-09-01",
        "quota_snapshots": {
          "premium_interactions": {
            "percent_remaining": 64.5
          },
          "chat": {
            "unlimited": true,
            "percent_remaining": 100
          }
        }
      },
      "expected": {
        "providerId": "copilot",
        "displayName": "Copilot",
        "iconId": "copilot",
        "primaryPercent": 35.5,
        "status": "ok",
        "fetchedAt": "2026-08-27T11:22:00.000Z",
        "buckets": [
          {
            "id": "premium",
            "label": "Premium requests",
            "percentUsed": 35.5,
            "resetsAt": "2026-09-01T00:00:00.000Z",
            "resetStyle": "absolute"
          }
        ]
      },
      "note": "Copilot reports what is left; Capsule shows what is used, so 64.5 remaining is 35.5 used. An unlimited quota has no percentage worth showing."
    },
    {
      "name": "fully consumed quota",
      "input": {
        "quota_snapshots": {
          "premium_interactions": {
            "percent_remaining": 0
          }
        }
      },
      "expected": {
        "providerId": "copilot",
        "displayName": "Copilot",
        "iconId": "copilot",
        "primaryPercent": 100,
        "status": "ok",
        "fetchedAt": "2026-08-27T11:22:00.000Z",
        "buckets": [
          {
            "id": "premium",
            "label": "Premium requests",
            "percentUsed": 100,
            "resetsAt": "2026-08-27T11:22:00.000Z",
            "resetStyle": "absolute"
          }
        ]
      }
    },
    {
      "name": "untouched quota",
      "input": {
        "quota_snapshots": {
          "premium_interactions": {
            "percent_remaining": 100
          }
        }
      },
      "expected": {
        "providerId": "copilot",
        "displayName": "Copilot",
        "iconId": "copilot",
        "primaryPercent": 0,
        "status": "ok",
        "fetchedAt": "2026-08-27T11:22:00.000Z",
        "buckets": [
          {
            "id": "premium",
            "label": "Premium requests",
            "percentUsed": 0,
            "resetsAt": "2026-08-27T11:22:00.000Z",
            "resetStyle": "absolute"
          }
        ]
      }
    },
    {
      "name": "empty payload",
      "input": {},
      "expected": {
        "providerId": "copilot",
        "displayName": "Copilot",
        "iconId": "copilot",
        "primaryPercent": null,
        "status": "ok",
        "fetchedAt": "2026-08-27T11:22:00.000Z",
        "buckets": []
      }
    }
  ]
