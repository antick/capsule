{
  "about": "retryAfterMs(header, now) — reads a Retry-After header in either of its two legal forms",
  "timeZone": "UTC",
  "frozenNow": "2026-08-27T11:22:00Z",
  "cases": [
    {
      "name": "delta seconds",
      "input": {
        "header": "30"
      },
      "expected": 30000
    },
    {
      "name": "HTTP date",
      "input": {
        "header": "Thu, 27 Aug 2026 11:23:00 GMT"
      },
      "expected": 60000
    },
    {
      "name": "unparseable value is no hint at all",
      "input": {
        "header": "soon"
      },
      "expected": null
    },
    {
      "name": "absent header",
      "input": {
        "header": null
      },
      "expected": null
    }
  ]
}
