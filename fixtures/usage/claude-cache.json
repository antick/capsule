{
  "about": "claudeUsageFromCache(raw) — the usage Claude Code already cached in ~/.claude.json, used when a live read is refused",
  "cases": [
    {
      "name": "nested cachedUsageUtilization.utilization",
      "input": "{\"cachedUsageUtilization\":{\"utilization\":{\"five_hour\":{\"utilization\":73,\"resets_at\":\"2026-08-27T12:13:00Z\"},\"seven_day\":{\"utilization\":7,\"resets_at\":\"2026-09-03T00:00:00Z\"}}}}",
      "expected": {
        "five_hour": {
          "utilization": 73,
          "resets_at": "2026-08-27T12:13:00Z"
        },
        "seven_day": {
          "utilization": 7,
          "resets_at": "2026-09-03T00:00:00Z"
        }
      }
    },
    {
      "name": "no cache present",
      "input": "{}",
      "expected": null
    },
    {
      "name": "unparseable file",
      "input": "garbage",
      "expected": null
    }
  ]
}
