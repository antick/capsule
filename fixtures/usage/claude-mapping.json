{
  "about": "mapClaudeUsage(payload, now) — Anthropic's usage response to a Capsule snapshot",
  "timeZone": "UTC",
  "frozenNow": "2026-08-27T11:22:00Z",
  "cases": [
    {
      "name": "five_hour becomes Current session and seven_day becomes All models",
      "input": {
        "five_hour": {
          "utilization": 73,
          "resets_at": "2026-08-27T12:13:00.000Z"
        },
        "seven_day": {
          "utilization": 7,
          "resets_at": "2026-09-03T00:00:00.000Z"
        }
      },
      "expected": {
        "providerId": "claude",
        "displayName": "Claude",
        "iconId": "claude",
        "primaryPercent": 73,
        "status": "ok",
        "fetchedAt": "2026-08-27T11:22:00.000Z",
        "buckets": [
          {
            "id": "current-session",
            "label": "Current session",
            "percentUsed": 73,
            "resetsAt": "2026-08-27T12:13:00.000Z",
            "resetStyle": "relative"
          },
          {
            "id": "all-models",
            "label": "All models",
            "percentUsed": 7,
            "resetsAt": "2026-09-03T00:00:00.000Z",
            "resetStyle": "absolute"
          }
        ]
      },
      "note": "The headline percent is the session window, not the weekly one."
    },
    {
      "name": "fractional utilization is read as a percent",
      "input": {
        "five_hour": {
          "utilization": 0.73
        }
      },
      "expected": {
        "providerId": "claude",
        "displayName": "Claude",
        "iconId": "claude",
        "primaryPercent": 73,
        "status": "ok",
        "fetchedAt": "2026-08-27T11:22:00.000Z",
        "buckets": [
          {
            "id": "current-session",
            "label": "Current session",
            "percentUsed": 73,
            "resetsAt": "2026-08-27T11:22:00.000Z",
            "resetStyle": "relative"
          }
        ]
      },
      "note": "The payload has no seven_day window, so there is no \"All models\" row to draw."
    },
    {
      "name": "only a session window",
      "input": {
        "five_hour": {
          "utilization": 44,
          "resets_at": "2026-08-27T13:00:00.000Z"
        }
      },
      "expected": {
        "providerId": "claude",
        "displayName": "Claude",
        "iconId": "claude",
        "primaryPercent": 44,
        "status": "ok",
        "fetchedAt": "2026-08-27T11:22:00.000Z",
        "buckets": [
          {
            "id": "current-session",
            "label": "Current session",
            "percentUsed": 44,
            "resetsAt": "2026-08-27T13:00:00.000Z",
            "resetStyle": "relative"
          }
        ]
      },
      "note": "An absent seven_day window produces no bucket at all — not one at 0% resetting \"now\"."
    },
    {
      "name": "only a weekly window",
      "input": {
        "seven_day": {
          "utilization": 7,
          "resets_at": "2026-09-03T00:00:00.000Z"
        }
      },
      "expected": {
        "providerId": "claude",
        "displayName": "Claude",
        "iconId": "claude",
        "primaryPercent": 7,
        "status": "ok",
        "fetchedAt": "2026-08-27T11:22:00.000Z",
        "buckets": [
          {
            "id": "all-models",
            "label": "All models",
            "percentUsed": 7,
            "resetsAt": "2026-09-03T00:00:00.000Z",
            "resetStyle": "absolute"
          }
        ]
      },
      "note": "With no session window, the weekly one is the headline — losing the session window must not lose the reading."
    },
    {
      "name": "empty payload",
      "input": {},
      "expected": {
        "providerId": "claude",
        "displayName": "Claude",
        "iconId": "claude",
        "primaryPercent": null,
        "status": "error",
        "fetchedAt": "2026-08-27T11:22:00.000Z",
        "buckets": []
      },
      "note": "A 200 carrying nothing usable: no bucket, a null primary percent, and status \"error\", so mergeSnapshot keeps the last good reading and marks it stale rather than publishing a confident 0%."
    },
    {
      "name": "null utilization",
      "input": {
        "five_hour": {
          "utilization": null,
          "resets_at": null
        },
        "seven_day": null
      },
      "expected": {
        "providerId": "claude",
        "displayName": "Claude",
        "iconId": "claude",
        "primaryPercent": null,
        "status": "error",
        "fetchedAt": "2026-08-27T11:22:00.000Z",
        "buckets": []
      },
      "note": "A window that is present but carries no utilization is still nothing known: no bucket, a null primary percent, and status \"error\", so mergeSnapshot keeps the last good reading instead."
    },
    {
      "name": "utilization over one hundred is clamped",
      "input": {
        "five_hour": {
          "utilization": 112,
          "resets_at": "2026-08-27T12:13:00.000Z"
        }
      },
      "expected": {
        "providerId": "claude",
        "displayName": "Claude",
        "iconId": "claude",
        "primaryPercent": 100,
        "status": "ok",
        "fetchedAt": "2026-08-27T11:22:00.000Z",
        "buckets": [
          {
            "id": "current-session",
            "label": "Current session",
            "percentUsed": 100,
            "resetsAt": "2026-08-27T12:13:00.000Z",
            "resetStyle": "relative"
          }
        ]
      }
    },
    {
      "name": "exhausted session",
      "input": {
        "five_hour": {
          "utilization": 100,
          "resets_at": "2026-08-27T12:13:00.000Z"
        },
        "seven_day": {
          "utilization": 96,
          "resets_at": "2026-09-03T00:00:00.000Z"
        }
      },
      "expected": {
        "providerId": "claude",
        "displayName": "Claude",
        "iconId": "claude",
        "primaryPercent": 100,
        "status": "ok",
        "fetchedAt": "2026-08-27T11:22:00.000Z",
        "buckets": [
          {
            "id": "current-session",
            "label": "Current session",
            "percentUsed": 100,
            "resetsAt": "2026-08-27T12:13:00.000Z",
            "resetStyle": "relative"
          },
          {
            "id": "all-models",
            "label": "All models",
            "percentUsed": 96,
            "resetsAt": "2026-09-03T00:00:00.000Z",
            "resetStyle": "absolute"
          }
        ]
      }
    }
  ]
}
