{
  "about": "nearestEdgeForPoint(point, bounds) — which edge a dropped dock re-docks to",
  "cases": [
    {
      "name": "left of a wide screen",
      "input": {
        "point": {
          "x": 100,
          "y": 450
        },
        "bounds": {
          "x": 0,
          "y": 0,
          "width": 1440,
          "height": 900
        }
      },
      "expected": "left"
    },
    {
      "name": "right of a wide screen",
      "input": {
        "point": {
          "x": 1300,
          "y": 450
        },
        "bounds": {
          "x": 0,
          "y": 0,
          "width": 1440,
          "height": 900
        }
      },
      "expected": "right"
    },
    {
      "name": "top of a wide screen",
      "input": {
        "point": {
          "x": 720,
          "y": 60
        },
        "bounds": {
          "x": 0,
          "y": 0,
          "width": 1440,
          "height": 900
        }
      },
      "expected": "top"
    },
    {
      "name": "bottom of a wide screen",
      "input": {
        "point": {
          "x": 720,
          "y": 860
        },
        "bounds": {
          "x": 0,
          "y": 0,
          "width": 1440,
          "height": 900
        }
      },
      "expected": "bottom"
    },
    {
      "name": "proportional distance favours the side on a wide screen",
      "input": {
        "point": {
          "x": 200,
          "y": 200
        },
        "bounds": {
          "x": 0,
          "y": 0,
          "width": 1440,
          "height": 900
        }
      },
      "expected": "left",
      "note": "200px from the left is 14% of the width but 200px from the top is 22% of the height, so left wins."
    },
    {
      "name": "dead centre ties every edge",
      "input": {
        "point": {
          "x": 720,
          "y": 450
        },
        "bounds": {
          "x": 0,
          "y": 0,
          "width": 1440,
          "height": 900
        }
      },
      "expected": "left",
      "note": "Ties break in the order left, right, top, bottom. A port must sort stably in that order or a centred drop re-docks somewhere else."
    },
    {
      "name": "on the diagonal of a square screen",
      "input": {
        "point": {
          "x": 100,
          "y": 100
        },
        "bounds": {
          "x": 0,
          "y": 0,
          "width": 1000,
          "height": 1000
        }
      },
      "expected": "left",
      "note": "Left and top tie exactly; the tie-break decides."
    },
    {
      "name": "just off the diagonal toward the top",
      "input": {
        "point": {
          "x": 101,
          "y": 100
        },
        "bounds": {
          "x": 0,
          "y": 0,
          "width": 1000,
          "height": 1000
        }
      },
      "expected": "top"
    },
    {
      "name": "outside the screen to the right",
      "input": {
        "point": {
          "x": 1600,
          "y": 450
        },
        "bounds": {
          "x": 0,
          "y": 0,
          "width": 1440,
          "height": 900
        }
      },
      "expected": "right",
      "note": "Affinity goes negative past an edge; that edge still wins."
    },
    {
      "name": "on an offset second display",
      "input": {
        "point": {
          "x": 3900,
          "y": 600
        },
        "bounds": {
          "x": 1440,
          "y": -120,
          "width": 2560,
          "height": 1440
        }
      },
      "expected": "right"
    },
    {
      "name": "near the top of an offset second display",
      "input": {
        "point": {
          "x": 2700,
          "y": -100
        },
        "bounds": {
          "x": 1440,
          "y": -120,
          "width": 2560,
          "height": 1440
        }
      },
      "expected": "top"
    },
    {
      "name": "zero-size bounds do not divide by zero",
      "input": {
        "point": {
          "x": 5,
          "y": 5
        },
        "bounds": {
          "x": 0,
          "y": 0,
          "width": 0,
          "height": 0
        }
      },
      "expected": "right"
    }
  ]
}
