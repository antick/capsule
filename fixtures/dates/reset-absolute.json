{
  "about": "formatResetAbsolute(resetsAt, locale, now) — wall-clock copy for a reset a day or more away",
  "timeZone": "UTC",
  "locale": "en-US",
  "frozenNow": "2026-08-27T11:22:00Z",
  "cases": [
    {
      "name": "next Thursday midnight",
      "input": {
        "resetsAt": "2026-09-03T00:00:00Z"
      },
      "expected": "Resets Thu 12:00 AM"
    },
    {
      "name": "later today",
      "input": {
        "resetsAt": "2026-08-27T15:00:00Z"
      },
      "expected": "Resets today 3:00 PM"
    },
    {
      "name": "tomorrow midnight",
      "input": {
        "resetsAt": "2026-08-28T00:00:00Z"
      },
      "expected": "Resets tomorrow 12:00 AM"
    },
    {
      "name": "named weekday inside the week",
      "input": {
        "resetsAt": "2026-08-29T09:30:00Z"
      },
      "expected": "Resets Sat 9:30 AM"
    }
  ]
}
