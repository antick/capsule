{
  "about" : "formatElapsed(since, now) — how long a session has been running",
  "cases" : [
    {
      "expected" : "just now",
      "input" : {
        "msBeforeNow" : 0
      },
      "name" : "this instant",
      "note" : "msBeforeNow is subtracted from frozenNow to get `since`."
    },
    {
      "expected" : "just now",
      "input" : {
        "msBeforeNow" : 44000
      },
      "name" : "just under the forty-five second rounding point"
    },
    {
      "expected" : "1 min",
      "input" : {
        "msBeforeNow" : 45000
      },
      "name" : "at the rounding point"
    },
    {
      "expected" : "3 min",
      "input" : {
        "msBeforeNow" : 180000
      },
      "name" : "whole minutes"
    },
    {
      "expected" : "2 hr",
      "input" : {
        "msBeforeNow" : 7200000
      },
      "name" : "whole hours drop the minutes"
    },
    {
      "expected" : "2 hr 5 min",
      "input" : {
        "msBeforeNow" : 7500000
      },
      "name" : "hours and minutes together"
    }
  ],
  "frozenNow" : "2026-08-27T11:22:00Z",
  "timeZone" : "UTC"
}
