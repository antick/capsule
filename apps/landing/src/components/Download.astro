---
import { site } from "../lib/site";
import Install from "./Install.astro";
---
<section id="download" class="download wrap" aria-labelledby="download-title">
  <h2 id="download-title">Park your limits where you can see them.</h2>
  <Install />
  <p class="fine-print">
    Signed with Developer ID and notarized by Apple. Updates arrive through
    Settings → Updates.
  </p>
  <p class="links">
    <a href={site.releases}>All releases</a>
    <a href={site.changelog}>What's new</a>
    <a href={site.build}>Build it yourself</a>
  </p>
</section>
